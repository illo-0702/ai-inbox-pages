# AI Inbox 환경 변수 예시 파일
# 실제 값은 .env.local 에 채우고 커밋하지 않는다. 이 파일은 키 이름과 설명만 담는다.

# AI 제공자 선택: demo(기본, 외부 호출 없음) | gemini(실제 외부 API 호출)
AI_PROVIDER=demo

# Gemini 사용 시에만 필요. 비어 있으면 gemini 모드가 활성화되어도 서버가 오류로 안내하고 호출하지 않는다.
GEMINI_API_KEY=

# Gemini 사용 시 모델 식별자. 공급자 공식 문서에서 최신 값을 확인 후 설정한다.
GEMINI_MODEL=

# SQLite 파일 경로. 비우면 로컬 기본 경로(data/ai-inbox.sqlite)를 사용한다.
DATABASE_PATH=

# 세션 쿠키 이름과 만료(초). 비우면 기본값(24시간) 사용.
SESSION_COOKIE_NAME=
SESSION_TTL_SECONDS=
