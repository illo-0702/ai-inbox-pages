# AI Inbox 환경 변수 예시. 복사해서 .env.local 을 만들고 값을 채운다(.env.local 은 커밋되지 않음).
# 모든 값이 비어 있어도 앱은 "데모 분석(규칙 기반)"으로 동작한다.

# ── AI 제공자 ────────────────────────────────────────────────
# 시도 순서. 설정되지 않은 제공자는 건너뛴다. 실패·시간 초과 시 다음 제공자로 넘어간다.
AI_PROVIDER_ORDER=omniroute,gemini,openrouter
# 모든 제공자가 실패하거나 하나도 설정되지 않았을 때 규칙 기반 데모 엔진으로 대체할지 (true/false)
AI_DEMO_FALLBACK=true
# 제공자별 시간 초과(ms)
AI_TIMEOUT_MS=20000

# OmniRoute (로컬 AI 라우터, OpenAI 호환). MODEL 이 비어 있으면 사용하지 않는다.
# 대시보드 → Endpoints 에서 발급한 API 키를 넣는다. 배포 서버에서는 로컬 OmniRoute에 접근할 수 없다.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Google Gemini (키와 모델이 모두 있어야 사용). 모델 식별자는 공식 문서에서 최신 값을 확인한다.
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter (키와 모델이 모두 있어야 사용)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── 저장소 ──────────────────────────────────────────────────
# 로컬: file:data/ai-inbox.db  /  배포(Turso): libsql://<db-name>-<org>.turso.io
DATABASE_URL=file:data/ai-inbox.db
DATABASE_AUTH_TOKEN=

# ── 세션·제한 ────────────────────────────────────────────────
# 데모 데이터 보관 기간(초). 기본 24시간 후 자동 삭제.
SESSION_TTL_SECONDS=86400
MAX_INPUT_CHARS=2000
ANALYZE_RATE_LIMIT_PER_HOUR=60
