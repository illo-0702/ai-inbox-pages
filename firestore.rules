// Firestore 보안 규칙 예시
// Firebase Console에서 이 규칙을 적용하거나,
// Firebase CLI를 통해 배포: firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 기본: 모든 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }

    // user_data 컬렉션: 사용자별 격리
    // - 각 사용자는 자신의 UID 문서만 읽기/쓰기 가능
    // - 인증되지 않은 사용자는 접근 불가
    match /user_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 문서 검증 규칙 (선택사항)
      // 저장되는 데이터가 올바른 구조인지 확인
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.version == 1
        && request.resource.data.keys().hasAll(['relationships', 'contacts', 'tasks', 'proposals', 'events']);
    }

    // 향후 확장용: 다른 컬렉션
    // 예) 친구와 공유하는 task, 협업 기능 등
    match /shared_tasks/{taskId} {
      // TODO: 협업 규칙 구현
      allow read, write: if false;
    }
  }
}
